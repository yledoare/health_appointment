<odoo>
    <record id="health_appointment_company_rule" model="ir.rule">
        <field name="name">Health Appointment multi-company</field>
        <field name="model_id" ref="model_health_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('health_appointment.group_health_appointment_user')), (4, ref('health_appointment.group_health_appointment_manager'))]"/>
    </record>
</odoo>


